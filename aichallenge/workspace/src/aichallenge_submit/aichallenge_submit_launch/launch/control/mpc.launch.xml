<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="true"/>
  <arg name="use_race_state_estimator" default="true"/>
  <!-- Requires use_obstacle_avoidance and use_race_state_estimator (and the
       bearing classifier, on by default); the node disables itself otherwise. -->
  <arg name="use_race_strategy_fsm" default="true"/>
  <!-- Requires use_obstacle_avoidance; the node disables itself otherwise. -->
  <arg name="use_standstill_recovery" default="true"/>
  <!-- Official boost item scheduler (issue #47). Needs the 2026-07-01+
       AWSIM binary; older ones silently ignore /awsim/cmd. -->
  <arg name="use_official_boost" default="true"/>

  <!-- MPC_CONFIG_PATH lets one vehicle in a multi-vehicle trial run an
       alternate MPC config (e.g. a slower preset) without a second
       worktree/build; unset means the packaged default (issue #104). -->
  <node pkg="multi_purpose_mpc_ros_custom" exec="run_mpc_controller.bash"
        name="mpc_controller" output="screen"
        args="--config_path $(env MPC_CONFIG_PATH $(find-pkg-share multi_purpose_mpc_ros_custom)/config/config.yaml)
              --ref_vel_path $(find-pkg-share multi_purpose_mpc_ros_custom)/config/ref_vel.yaml">

    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
    <param name="use_race_state_estimator" value="$(var use_race_state_estimator)"/>
    <param name="use_race_strategy_fsm" value="$(var use_race_strategy_fsm)"/>
    <param name="use_standstill_recovery" value="$(var use_standstill_recovery)"/>
    <param name="use_official_boost" value="$(var use_official_boost)"/>
    <param name="use_stats" value="true"/>
    <!-- Time-domain MPCC opt-in. UPDATE (2026-08-07): flipped back to
         true for this submission cycle. Every legacy candidate tried
         since the 2026-08-03 revert (fsm-combined1 trial21, fsm-combined-
         jitter3 trial22, fsm-combined-anchor324a9ba-1 trial2, and even an
         exact reproduction of the 2026-07-17 submission 324a9ba itself)
         has shown 8-17 real kinematic penalty events, well above what any
         of those configs' local trial3 re-checks predicted; the
         synthetic-vs-real generalization gap that originally motivated
         moving away from MPCC turned out not to be MPCC-specific.
         Submitting mpc@198a4fe (mpcc.branch_switch_margin_frac raised
         0.02->0.40, weights.q_contour 0.70->2.0, see that repo's commit
         for the full replay-based rationale: every genuine wall-contact
         event in the last MPCC submission, ac6da94/board-59768d04, had a
         real opponent within 3-13m at the moment of contact) as a fresh
         data point. Local make trial3 (USE_MPCC=true): penalties 17->2,
         no wall contact, but best_lap collapsed to 105.4s and overtakes
         dropped from 2/2 to 1/2 opponents passed (likely overcorrected),
         submitting anyway to get a real-race baseline on this mechanism.
         A packaged submission does not set this host env var, so this
         default is what the official board runs; local `make trial`/
         `make trial3` runs are unaffected since the Makefile always
         exports USE_MPCC explicitly either way. Set USE_MPCC=false on the
         host to force the legacy controller. -->
    <param name="use_mpcc" value="$(env USE_MPCC true)"/>
  </node>
</launch>
