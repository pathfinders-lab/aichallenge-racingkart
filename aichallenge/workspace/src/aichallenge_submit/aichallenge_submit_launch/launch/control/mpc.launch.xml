<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="true"/>
  <arg name="use_race_state_estimator" default="true"/>
  <!-- Requires use_obstacle_avoidance and use_race_state_estimator (and the
       bearing classifier, on by default); the node disables itself otherwise. -->
  <arg name="use_race_strategy_fsm" default="true"/>
  <!-- Requires use_obstacle_avoidance; the node disables itself otherwise. -->
  <arg name="use_standstill_recovery" default="true"/>
  <!-- Official boost item scheduler (issue #47). Needs the 2026-07-01+
       AWSIM binary; older ones silently ignore /awsim/cmd. -->
  <arg name="use_official_boost" default="true"/>

  <!-- MPC_CONFIG_PATH lets one vehicle in a multi-vehicle trial run an
       alternate MPC config (e.g. a slower preset) without a second
       worktree/build; unset means the packaged default (issue #104). -->
  <node pkg="multi_purpose_mpc_ros_custom" exec="run_mpc_controller.bash"
        name="mpc_controller" output="screen"
        args="--config_path $(env MPC_CONFIG_PATH $(find-pkg-share multi_purpose_mpc_ros_custom)/config/config.yaml)
              --ref_vel_path $(find-pkg-share multi_purpose_mpc_ros_custom)/config/ref_vel.yaml">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
    <param name="use_race_state_estimator" value="$(var use_race_state_estimator)"/>
    <param name="use_race_strategy_fsm" value="$(var use_race_strategy_fsm)"/>
    <param name="use_standstill_recovery" value="$(var use_standstill_recovery)"/>
    <param name="use_official_boost" value="$(var use_official_boost)"/>
    <param name="use_stats" value="true"/>
  </node>
</launch>
